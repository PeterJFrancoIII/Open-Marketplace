# Public link used by the "Fund it" button. GitHub Sponsors, Open Collective,
# or any transparent donation page works.
NEXT_PUBLIC_DONATION_URL=

# Optional link shown anywhere a deployment wants to point back to its source.
NEXT_PUBLIC_PROJECT_REPO_URL=https://github.com/PeterJFrancoIII/Open-Marketplace

# Optional public origin used for favicon and chat-link preview (Open Graph) URLs.
# Preview deploys can leave this unset; Cloudflare Pages supplies CF_PAGES_URL.
NEXT_PUBLIC_SITE_URL=

# Required server-only secret for signing and encrypting account sessions.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Exact, comma-separated account emails allowed to open /admin.
MARKETPLACE_ADMIN_EMAILS=

# Preview-only social Connect. Never commit values. Production must not set these keys.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Preview-only Parcel Monkey GetQuote. Never book shipments. Production must not set these.
# Pirate Ship has no public third-party rates API; the app links to pirateship.com/ship.
PARCEL_MONKEY_USER_ID=
PARCEL_MONKEY_API_TOKEN=
