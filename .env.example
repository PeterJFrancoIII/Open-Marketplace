# Public link used by the "Fund it" button. GitHub Sponsors, Open Collective,
# or any transparent donation page works.
NEXT_PUBLIC_DONATION_URL=

# Optional moderator capability token for policy cancellations (never commit real values).
MODERATOR_TOKEN=

# Optional registry identifier used when signing trust event envelopes (PR 7).
NEXT_PUBLIC_REGISTRY_ID=open-marketplace-local

# PR 5 — Social OAuth (never commit real secrets).
# 32-byte key as 64-char hex or base64. Used only to seal provider tokens in D1.
OAUTH_TOKEN_ENCRYPTION_KEY=
# Facebook Login app credentials (Authorization Code + PKCE).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional Graph API version (default v21.0).
FACEBOOK_GRAPH_VERSION=v21.0
# Local/dev only: use the deterministic mock Facebook adapter without Meta credentials.
ALLOW_MOCK_OAUTH=
